# Zathura, in the house palette and with the reading manners we want.
#
# The colours are NOT here: `colors` is generated by scripts/gen-theme.py from
# the active palette and linked next to this file by install.sh. zathurarc's
# `include` resolves a relative path against the including file, so the plain
# name works from the symlink.
include colors

# Paper becomes the background and ink the text -- the point of a dark desktop.
# `ctrl+r` toggles it live, and `set recolor false` is the one line to undo it.
set recolor true
# Photographs and diagrams stay in their own colours instead of being inverted.
set recolor-reverse-video true

# A framed page instead of the document jammed against the window edges.
set page-h-padding 16
set page-v-padding 16

# How it reads: resume where the document was left, short name in the bar, and
# selections to the real clipboard (ctrl+v) instead of the primary one.
set open-first-page false
set statusbar-basename true
set statusbar-home-tilde true
set selection-clipboard clipboard

# The plain database is deprecated in this version.
set database sqlite
