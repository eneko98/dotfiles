// The fetch card, alive: the same eleven rows as the terminal's fastfetch,
// updating. Static rows are read once (SystemInfo); the ones that move come
// from Resources, which already samples for the dashboard, so the widget adds
// no sampling of its own -- only a df every 30 s while it is on screen.
//
// Typography is the terminal's, on purpose: JetBrainsMono everywhere, keys in
// the neon and values in fg0, the title split accent/neon -- the same roles
// the terminal fetch gets through its ANSI names. The title row gets real
// weight (13, bold) and a hairline under it, because a card needs a header,
// not eleven equal lines.
import QtQuick
import Quickshell

Widget {
    id: root

    widgetId: "fetch"
    cardW: 420
    cardH: 240

    // While the card is hidden there is nothing to feed: the disk reader
    // stops, and Resources already pauses its own extra timers.
    onVisibleChanged: SystemInfo.watched = root.visible

    // The tinted Arch mark, generated by gen-theme.py with the palette.
    // Centred against the text block: a logo floating at the top of a tall
    // card reads as a mistake.
    Image {
        x: 20
        y: 20 + (200 - 92) / 2
        width: 92
        height: 92
        source: "file://" + Quickshell.env("HOME")
            + "/.config/fastfetch/logo.png"
        fillMode: Image.PreserveAspectFit
    }

    Column {
        x: 132
        y: 20
        width: parent.width - 132 - 20
        spacing: 0

        // The title: user in the accent, host in the neon, like the
        // terminal fetch's first line -- but with the weight of a header.
        Text {
            height: 18

            text: SystemInfo.user
            color: Theme.gold
            font.family: "JetBrainsMono Nerd Font"
            font.pixelSize: 13
            font.bold: true

            Text {
                anchors.left: parent.right
                text: "@"
                color: Theme.fg2
                font.family: "JetBrainsMono Nerd Font"
                font.pixelSize: 13
                font.bold: true

                Text {
                    anchors.left: parent.right
                    text: SystemInfo.host
                    color: Theme.teal
                    font.family: "JetBrainsMono Nerd Font"
                    font.pixelSize: 13
                    font.bold: true
                }
            }
        }

        // A hairline: the header ends, the data begins.
        Item { width: 1; height: 6 }

        Rectangle {
            width: parent.width
            height: 1
            color: Qt.rgba(Theme.fg0.r, Theme.fg0.g, Theme.fg0.b, 0.08)
        }

        Item { width: 1; height: 8 }

        Repeater {
            model: root.values.length

            delegate: Row {
                required property int index

                spacing: 0
                height: 16

                Text {
                    width: 78
                    text: root.values[index].k
                    color: Theme.teal
                    font.family: "JetBrainsMono Nerd Font"
                    font.pixelSize: 11
                }

                Text {
                    width: parent.width - 78
                    text: root.values[index].v
                    elide: Text.ElideRight
                    // One alarm use of the red: the temperature is the only
                    // row that can mean "go look at it now".
                    color: root.values[index].hot ? Theme.red : Theme.fg0
                    font.family: "JetBrainsMono Nerd Font"
                    font.pixelSize: 11
                }
            }
        }
    }

    // Rebuilt whenever any of the live inputs changes; the delegates only
    // re-read their row, so a tick costs ten text updates.
    readonly property var values: [
        {
            k: "OS",
            v: SystemInfo.distro + (SystemInfo.arch !== ""
                ? " " + SystemInfo.arch : "")
        },
        { k: "Kernel", v: SystemInfo.kernel },
        { k: "Uptime", v: root.fmtUp(SystemInfo.upSec) },
        { k: "Packages", v: SystemInfo.packages + " (pacman)" },
        { k: "Shell", v: SystemInfo.shell },
        { k: "WM", v: SystemInfo.wm },
        {
            k: "CPU",
            v: root.cpuShort() + " · " + Math.round(Resources.cpu * 100)
                + " % · " + (Resources.cpuMHz / 1000).toFixed(1) + " GHz"
        },
        {
            k: "GPU",
            v: "Vega 8 · " + (isNaN(Resources.gpu) ? "—" : Math.round(
                Resources.gpu * 100) + " %") + " · "
                + (isNaN(Resources.tempC) ? "—"
                    : Math.round(Resources.tempC) + " °C"),
            hot: !isNaN(Resources.tempC) && Resources.tempC >= 85
        },
        {
            k: "Memory",
            v: Resources.memUsedGiB.toFixed(1) + " / "
                + Resources.memTotalGiB.toFixed(1) + " GiB ("
                + Math.round(Resources.memUsed * 100) + " %)"
        },
        {
            k: "Disk",
            v: (SystemInfo.disk.total > 0
                ? (SystemInfo.disk.used / Math.pow(1024, 3)).toFixed(1)
                    + " / " + (SystemInfo.disk.total / Math.pow(1024, 3))
                    .toFixed(1) + " GiB ("
                    + Math.round(SystemInfo.disk.used / SystemInfo.disk.total
                        * 100) + " %)"
                : "—")
        }
    ]

    // The model name in /proc/cpuinfo is the marketing one ("AMD Ryzen 5
    // 3500U with Radeon Vega Mobile Gfx"); the card wants the short form the
    // terminal fetch shows.
    function cpuShort() {
        if (SystemInfo.cpuModel === "")
            return "—";
        return SystemInfo.cpuModel.replace(/^AMD /, "")
            .replace(/ with Radeon.*$/, "");
    }

    function fmtUp(sec) {
        const d = Math.floor(sec / 86400);
        const h = Math.floor((sec % 86400) / 3600);
        const m = Math.floor((sec % 3600) / 60);
        return d > 0 ? (d + " d " + h + " h") : (h + " h " + m + " m");
    }
}
