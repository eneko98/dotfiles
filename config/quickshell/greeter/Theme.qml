// Generated-format singleton with the committed default palette, the same
// roles and values as config/hypr/theme.lua. The copy installed for the real
// greeter (/etc/greetd/quickshell/Theme.qml) is overwritten by gen-theme.py
// with the active palette; this one only exists so the demo runs from the repo.
pragma Singleton
import QtQuick

QtObject {
    readonly property color bg0: "#06060a"
    readonly property color bg1: "#0e0e15"
    readonly property color bg2: "#171621"
    readonly property color fg0: "#d0d0da"
    readonly property color fg1: "#86859b"
    readonly property color fg2: "#5f5f70"
    readonly property color gold: "#5eadcc"
    readonly property color teal: "#ab8bd2"
    readonly property color red: "#c6482f"
}
