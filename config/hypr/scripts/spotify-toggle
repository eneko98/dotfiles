#!/bin/sh
# Bring Spotify to the current workspace if it is running, or launch it if it
# is not. Used by a left click on its tray icon: the official client has no
# close-to-tray, so moving it to another workspace is the way to keep it
# playing, and this is the way back.
if hyprctl clients -j | jq -e '.[] | select(.class == "Spotify")' >/dev/null 2>&1; then
    hyprctl dispatch 'hl.dsp.focus({ window = "class:Spotify" })'
else
    spotify-launcher --skip-update >/dev/null 2>&1 &
fi
