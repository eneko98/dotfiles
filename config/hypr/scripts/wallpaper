#!/bin/sh
#
# Wallpaper state and application.
#
#   wallpaper            open the picker (through the bar's IPC)
#   wallpaper set PATH   apply it now, remember it, regenerate the lock background
#   wallpaper restore    apply the remembered one (login unit)
#
# hyprpaper gets the live change; the state lives under XDG_STATE_HOME, not in
# the repo, so the tracked hyprpaper.conf stays the default.
#
# The lock screen shows a blurred copy of the chosen image, generated here into
# the state dir; LockSurface.qml falls back to the committed default when it is
# missing (first boot).

set -eu

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
state_file="$state_dir/wallpaper"
lock_file="$state_dir/lock-wallpaper.png"

# This script is symlinked into ~/.config; resolve its real location to find the
# repository, so the generator paths do not need a hardcoded clone location.
here=$(dirname "$(readlink -f "$0")")
repo=$(cd "$here/../../.." && pwd)

blur() {
	[ -f "$1" ] || return 0
	mkdir -p "$state_dir"
	magick "$1" -resize '1920x1080^' -gravity center -extent 1920x1080 \
		-blur 0x18 -modulate 55,95,100 "$lock_file" 2>/dev/null || true
}

# At login the restore unit starts alongside the graphical session, so hyprpaper
# may not be listening yet; retry briefly instead of dropping the choice.
apply() {
	i=0
	while [ "$i" -lt 60 ]; do
		if hyprctl hyprpaper wallpaper ", $1" >/dev/null 2>&1; then
			return 0
		fi
		i=$((i + 1))
		sleep 0.5
	done
	return 1
}

# The login screen is system state too: the greeter user cannot read this home
# (0700), so the greeter's QML, its generated theme, the regreet fallback CSS and
# the current wallpaper's blurred copy are installed into /etc/greetd and
# /usr/share/backgrounds. sudo is passwordless here; if it is not, the greeter
# simply keeps the previous theme.
install_greeter() {
	css="$state_dir/theme/greeter/regreet.css"
	if [ -f "$css" ]; then
		sudo -n install -m 644 "$css" /etc/greetd/regreet.css 2>/dev/null || true
	fi
	if [ -f "$lock_file" ]; then
		sudo -n install -m 644 "$lock_file" /usr/share/backgrounds/greeter.png 2>/dev/null || true
	fi
	qml_dir="$repo/config/quickshell/greeter"
	theme="$state_dir/theme/greeter/Theme.qml"
	if [ -d "$qml_dir" ]; then
		sudo -n rm -rf /etc/greetd/quickshell
		sudo -n cp -r "$qml_dir" /etc/greetd/quickshell
		if [ -f "$theme" ]; then
			sudo -n install -m 644 "$theme" /etc/greetd/quickshell/Theme.qml 2>/dev/null || true
		fi
		sudo -n chmod 755 /etc/greetd/quickshell
		sudo -n chmod 644 /etc/greetd/quickshell/* 2>/dev/null || true
	fi
}

# The icon variant follows the accent; gen-theme.py wrote its name. GSettings is
# what the portal (and through it GTK and fuzzel) reads.
set_icon_theme() {
	file="$state_dir/theme/icon-theme"
	[ -f "$file" ] || return 0
	gsettings set org.gnome.desktop.interface icon-theme "$(cat "$file")" 2>/dev/null || true
}

case "${1:-}" in
set)
	[ -n "${2:-}" ] && [ -f "$2" ] || exit 1
	# Remember an absolute path: the restore unit does not run in this cwd.
	path=$(readlink -f "$2")
	apply "$path" || exit 1
	mkdir -p "$state_dir"
	printf '%s\n' "$path" >"$state_file"
	blur "$path"

	# The palette follows the wallpaper: re-derive it, rewrite the generated
	# copies and refresh what reloads live (Hyprland, kitty, and Quickshell --
	# which watches its Theme.qml link). Apps that read their theme at startup
	# (GTK, Qt, Firefox, yazi, fuzzel, hyprlock) pick it up when they next start.
	if [ -x "$repo/scripts/extract-palette.py" ]; then
		"$repo/scripts/extract-palette.py" "$path" >"$state_dir/retheme.log" 2>&1 || true
		"$repo/scripts/gen-theme.py" >/dev/null 2>&1 || true
		set_icon_theme
		install_greeter
		systemctl --user restart polkit-gnome.service >/dev/null 2>&1 || true
		hyprctl reload >/dev/null 2>&1 || true
		pkill -USR1 -x kitty 2>/dev/null || true
	fi
	;;
sync-greeter)
	install_greeter
	;;
restore)
	[ -f "$state_file" ] || exit 0
	path=$(cat "$state_file")
	[ -f "$path" ] || exit 0
	printf 'restoring wallpaper %s\n' "$path"
	apply "$path" || true
	blur "$path"
	set_icon_theme
	install_greeter
	;;
*)
	exec qs ipc call wallpaper toggle
	;;
esac
